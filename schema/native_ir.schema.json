{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://il-lang.dev/schema/native_ir.schema.json",
  "title": "Intelligent language fixed-width native IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "input_hash",
    "source_revision",
    "target",
    "mode",
    "layouts",
    "globals",
    "externs",
    "functions",
    "runtime_profile",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "compiler_version": {
      "type": "string"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "target": {
      "const": "x86_64-unknown-linux-gnu"
    },
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "layouts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layout"
      }
    },
    "globals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    },
    "externs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "signature",
          "noreturn"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "signature": {
            "$ref": "#/$defs/signature"
          },
          "noreturn": {
            "type": "boolean"
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "runtime_profile": {
      "enum": [
        "full",
        "minimal",
        "none"
      ]
    },
    "requirements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "program_graph.schema.json#/$defs/capability"
      }
    }
  },
  "$defs": {
    "type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "void"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ptr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bits"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "bits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      ]
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "register"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bits",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "global"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "parameters"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/type"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        }
      }
    },
    "mode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entry"
          ],
          "properties": {
            "kind": {
              "const": "application"
            },
            "entry": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entry",
            "arguments",
            "limits"
          ],
          "properties": {
            "kind": {
              "const": "captured"
            },
            "entry": {
              "type": "string"
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "execution.schema.json#/$defs/value"
              }
            },
            "limits": {
              "$ref": "execution.schema.json#/$defs/limits"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "exports"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fields",
        "offsets"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offsets": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      }
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
