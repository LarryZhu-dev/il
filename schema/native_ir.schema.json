            },
            "value": {
              "$ref": "#/$defs/operand"
            },
            "align": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "destination",
