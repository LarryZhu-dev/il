          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "signed",
            "bits"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "signed": {
              "type": "boolean"
            },
            "bits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "utf8"
          ],
          "properties": {
            "kind": {
              "const": "buffer"
            },
            "utf8": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "names",
            "fields",
            "offsets"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "offsets": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields",
            "offsets"
          ],
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "offsets": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
