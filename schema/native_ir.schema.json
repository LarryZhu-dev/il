                "ult",
                "ule",
                "ugt",
                "uge",
                "slt",
                "sle",
                "sgt",
                "sge"
              ]
            },
            "left": {
              "$ref": "#/$defs/operand"
            },
            "right": {
              "$ref": "#/$defs/operand"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operation",
            "value",
