{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://il-lang.dev/schema/program_graph.schema.json",
  "title": "Intelligent language canonical program graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "graph_version",
    "revision",
    "target",
    "modules",
    "types",
    "functions",
    "capabilities",
    "packages",
    "contracts"
  ],
  "properties": {
    "project_id": {
      "const": "il"
    },
    "graph_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "target": {
      "const": "x86_64-unknown-linux-gnu"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
