      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "name",
        "type"
      ],
      "properties": {
