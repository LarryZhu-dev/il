    if let Some(encoded) = path.strip_prefix("/hello/") {
        if encoded.is_empty() || encoded.contains('/') { return Response::text(404, "not found"); }
        let mut bytes = Vec::new();
        let mut input = encoded.bytes();
        while let Some(byte) = input.next() {
            if byte == b'%' {
                let digit = |b: u8| (b as char).to_digit(16);
                let pair = input.next().and_then(digit).zip(input.next().and_then(digit));
                let Some((high, low)) = pair else { return Response::text(400, "invalid path encoding"); };
                bytes.push((high * 16 + low) as u8);
            } else { bytes.push(byte); }
        }
        let Ok(name) = String::from_utf8(bytes) else { return Response::text(400, "invalid path encoding"); };
        let mut escaped = String::new();
        for character in name.chars() {
            match character {
                '"' => escaped.push_str("\\\""),
                '\\' => escaped.push_str("\\\\"),
                c if c < ' ' => escaped.push_str(&format!("\\u{:04x}", c as u32)),
                c => escaped.push(c),
            }
        }
        return Response { status: 200, content_type: "application/json; charset=utf-8",
            body: format!("{{\"message\":\"Hello, {}\"}}", escaped) };
    }
