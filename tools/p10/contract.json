{
  "schema_version": "1.0.0",
  "target": "x86_64-unknown-linux-gnu",
  "gates": {
    "G0": [
      "graph_schema_valid",
      "type_checker_verified",
      "ownership_checker_verified",
      "MIR_verifier_verified",
      "interpreter_semantic_suite_passed"
    ],
    "G1": [
      "native_elf_generated",
      "clean_environment_runs",
      "no_high_level_target_source",
      "reproducible_hash"
    ],
    "G2": [
      "inspect_succeeds",
      "slice_succeeds",
      "transaction_add_route_succeeds",
      "stale_transaction_rejected",
      "failure_preserves_previous_revision"
    ],
    "G3": [
      "blackbox_tests_external",
      "all_artifacts_hashed",
      "diagnostics_machine_readable",
      "rollback_verified"
    ]
  },
  "required_artifact_roles": [
    "graph",
    "compiler",
    "runtime",
    "native_elf",
    "toolchain_lock"
  ],
  "release_executable_role": "application_release",
  "required_http_profiles": ["debug", "release"],
  "executable_inventory_fields": [
    "role",
    "kind",
    "profile",
    "target",
    "entry_point",
    "graph_revision",
    "graph_sha256",
    "runtime_profile",
    "build_invocation_sha256",
    "artifact_role"
  ],
  "http_receipt_fields": [
    "schema_version",
    "kind",
    "case_id",
    "client",
    "executable_role",
    "profile",
    "contract_sha256",
    "exchange",
    "process",
    "policy",
    "assertions"
  ],
  "http_case_fields": ["id", "profile", "exit_code", "count", "receipt"],
  "http_case_profile_matrix": "every_http_case_once_per_required_profile",
  "http_exchange_record": {
    "kind": "tcp_exchange",
    "required_fields": [
      "schema_version", "kind", "exchange_id", "phase", "peer", "started_ns", "ended_ns",
      "elapsed_ns", "timeout_seconds", "planned_fragments", "requested_delays_ns", "request",
      "response", "events", "terminal", "error", "mode", "response_read", "status", "headers",
      "body", "assertions"
    ],
    "byte_reference_fields": ["planned_fragments[*].bytes", "request", "response", "events[*].bytes"],
    "required_event_fields": ["direction", "timestamp_ns", "bytes"],
    "optional_event_fields": ["fragment_index"],
    "required_assertion_fields": ["id", "passed"]
  },
  "http_process_record": {
    "kind": "http_server_process",
    "required_fields": [
      "argv", "pid", "started_ns", "ended_ns", "sha256", "profile", "policy_sha256", "exit_code",
      "stdout", "stderr", "termination_signal", "cleanup_intent", "cleanup_reaped"
    ],
    "byte_reference_fields": ["stdout", "stderr"],
    "sha256_field_binds": "server_executable_bytes"
  },
  "http_cases": [
    "health",
    "hello",
    "not_found",
    "method_not_allowed",
    "malformed_percent_encoding",
    "fragmented_request",
    "conflicting_content_length",
    "oversized_request_line",
    "oversized_headers",
    "read_timeout",
    "absolute_deadline",
    "partial_write",
    "disconnect_recovery",
    "path_parameter_limit",
    "transfer_encoding_rejected"
  ],
  "g4": {
    "trial_count": 3,
    "implementations": ["rust", "il"],
    "tasks": {
      "add_route": ["route_present", "typecheck", "http_blackbox"],
      "fix_type_error": ["diagnostic_machine_readable", "repair_applied", "regression_suite"],
      "rollback": ["rollback_transaction", "restored_graph_matches", "previous_binary_runs"]
    },
    "failure_categories": [
      "assertion",
      "compile",
      "environment",
      "other",
      "test",
      "timeout",
      "tool"
    ]
  },
  "limits": {
    "bundle_bytes": 536870912,
    "record_bytes": 16777216
  }
}
