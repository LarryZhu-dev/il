{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://il-lang.dev/schema/p10-bundle-1.0.0.json",
  "title": "il P10 execution evidence bundle structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_commit",
    "target",
    "toolchain_lock_sha256",
    "executables",
    "predicates",
    "artifacts",
    "comparison"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "p10_acceptance_bundle"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "const": "x86_64-unknown-linux-gnu"
    },
    "toolchain_lock_sha256": {
      "$ref": "#/$defs/hash"
    },
    "executables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executable" }
    },
    "predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_schema_valid",
        "type_checker_verified",
        "ownership_checker_verified",
        "MIR_verifier_verified",
        "interpreter_semantic_suite_passed",
        "native_elf_generated",
        "clean_environment_runs",
        "no_high_level_target_source",
        "reproducible_hash",
        "inspect_succeeds",
        "slice_succeeds",
        "transaction_add_route_succeeds",
        "stale_transaction_rejected",
        "failure_preserves_previous_revision",
        "blackbox_tests_external",
        "all_artifacts_hashed",
        "diagnostics_machine_readable",
        "rollback_verified"
      ],
      "patternProperties": {
        ".+": {
          "$ref": "#/$defs/recordReference"
        }
      },
      "propertyNames": {
        "enum": [
          "graph_schema_valid",
          "type_checker_verified",
          "ownership_checker_verified",
          "MIR_verifier_verified",
          "interpreter_semantic_suite_passed",
          "native_elf_generated",
          "clean_environment_runs",
          "no_high_level_target_source",
          "reproducible_hash",
          "inspect_succeeds",
          "slice_succeeds",
          "transaction_add_route_succeeds",
          "stale_transaction_rejected",
          "failure_preserves_previous_revision",
          "blackbox_tests_external",
          "all_artifacts_hashed",
          "diagnostics_machine_readable",
          "rollback_verified"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_sha256",
        "baseline_commit",
        "trials"
      ],
      "properties": {
        "task_contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "trials": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {
            "$ref": "#/$defs/recordReference"
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "byteReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "kind", "profile", "target", "entry_point", "graph_revision",
        "graph_sha256", "runtime_profile", "build_invocation_sha256", "artifact_role"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["application", "captured", "compiler", "runtime"] },
        "profile": { "enum": ["debug", "release", "captured", "tool"] },
        "target": { "const": "x86_64-unknown-linux-gnu" },
        "entry_point": { "type": "string", "minLength": 1 },
        "graph_revision": { "type": "integer", "minimum": 0 },
        "graph_sha256": { "$ref": "#/$defs/hash" },
        "runtime_profile": { "enum": ["full", "minimal", "none"] },
        "build_invocation_sha256": { "$ref": "#/$defs/hash" },
        "artifact_role": { "type": "string", "minLength": 1 }
      }
    },
    "httpReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "case_id", "client", "executable_role", "profile",
        "contract_sha256", "exchange", "process", "policy", "assertions"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "kind": { "const": "http_exchange" },
        "case_id": { "type": "string", "minLength": 1 },
        "client": { "const": "external_tcp" },
        "executable_role": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["debug", "release"] },
        "contract_sha256": { "$ref": "#/$defs/hash" },
        "exchange": { "$ref": "#/$defs/recordReference" },
        "process": { "$ref": "#/$defs/recordReference" },
        "policy": { "$ref": "#/$defs/recordReference" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "passed": { "const": true }
            }
          }
        }
      }
    },
    "httpCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "exit_code", "count", "receipt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["debug", "release"] },
        "exit_code": { "const": 0 },
        "count": { "const": 1 },
        "receipt": { "$ref": "#/$defs/recordReference" }
      }
    }
  },
  "description": "Structural validation is provisional and does not establish execution provenance or P10 acceptance. HTTP and process record references are separately checked against the locked P10 contract."
}
